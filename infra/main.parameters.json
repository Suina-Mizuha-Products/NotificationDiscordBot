{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "principalId": {
        "value": "${AZURE_PRINCIPAL_ID}"
      },
      "environmentName": {
        "value": "${AZURE_ENV_NAME}"
      },
      "location": {
        "value": "${AZURE_LOCATION}"
      },
      "containerAppEnvironmentMode": {
        "value": "${ACA_ENV_MODE}"
      },
      "sharedContainerAppEnvironmentName": {
        "value": "${SHARED_ACA_ENV_NAME}"
      },
      "sharedContainerAppEnvironmentResourceGroupName": {
        "value": "${SHARED_ACA_ENV_RG}"
      }
   }
}