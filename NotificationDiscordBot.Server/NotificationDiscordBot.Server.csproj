<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ae6e2cf1-a58d-41f9-8d9b-7a1ae9414353</UserSecretsId>
	  <ContainerRegistry>ghcr.io</ContainerRegistry>
	  <ContainerRepository>$\{IMAGE_REPOSITORY}/bot-server</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.20.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NotificationDiscordBot.ServiceDefaults\NotificationDiscordBot.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
